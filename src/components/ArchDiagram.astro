---
import { ui, type Lang } from '../data/i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = ui[lang];
const d = t.diagram;
const font = 'IBM Plex Sans, system-ui, sans-serif';
// Hand-drawn platform diagram. Generic by design: it shows the stack described in the CV, no client data.
// Two drawings of the same content: a wide one, and a vertical one for phones (CSS shows one of them).
---
<figure class="diagram">
  <svg viewBox="0 0 480 400" role="img" aria-labelledby="arch-t arch-d" class="diagram-wide w-full max-w-[34rem] overflow-visible">
    <title id="arch-t">{t.diagramTitle}</title>
    <desc id="arch-d">{d.desc}</desc>

    <g font-family={font} font-size="15" text-anchor="middle">
      <!-- Delivery path -->
      <rect class="d-box" x="0" y="24" width="110" height="44" /><text class="d-text" x="55" y="51">{d.git}</text>
      <rect class="d-box" x="175" y="24" width="130" height="44" /><text class="d-text" x="240" y="51">GitLab CI/CD</text>
      <rect class="d-box" x="340" y="24" width="130" height="44" /><text class="d-text" x="405" y="51">Terraform</text>

      <!-- Targets -->
      <rect class="d-box" x="0" y="140" width="310" height="82" />
      <text class="d-sub" x="155" y="164" font-size="14">{d.clouds}</text>
      <text class="d-text" x="155" y="189">AWS, Google Cloud, Azure,</text>
      <text class="d-text" x="155" y="210">Scaleway, Outscale</text>

      <rect class="d-box" x="330" y="140" width="150" height="82" />
      <text class="d-sub" x="405" y="164" font-size="14">On-premises</text>
      <text class="d-text" x="405" y="189">VMware, OpenShift,</text>
      <text class="d-text" x="405" y="210">Linux</text>

      <!-- Platform -->
      <rect class="d-box" x="0" y="256" width="480" height="44" />
      <text class="d-text" x="240" y="283">Kubernetes: EKS, GKE, AKS, OpenShift</text>

      <!-- Observability -->
      <rect class="d-dash" x="0" y="340" width="480" height="40" />
      <text class="d-sub" x="240" y="365">{d.observability}</text>
    </g>

    <!-- Delivery path, the single accent, drawn once on load -->
    <path class="d-flow flow" pathLength="1" d="M110 46 H175" />
    <path class="d-flow flow flow-2" pathLength="1" d="M305 46 H340" />
    <path class="d-flow flow flow-3" pathLength="1" d="M405 68 V104 M155 104 H405 M155 104 V140 M405 104 V140" />
    <path class="d-flow flow flow-4" pathLength="1" d="M155 222 V256 M405 222 V256" />
    <path class="d-arrow" d="M175 46 l-7 -4 v8 z M340 46 l-7 -4 v8 z" />
    <path class="d-dots" d="M240 300 V340" />
  </svg>

  <svg viewBox="0 0 300 568" role="img" aria-labelledby="arch-nt arch-nd" class="diagram-narrow w-full max-w-[22rem] overflow-visible">
    <title id="arch-nt">{t.diagramTitle}</title>
    <desc id="arch-nd">{d.desc}</desc>

    <g font-family={font} font-size="15" text-anchor="middle">
      <rect class="d-box" x="0" y="0" width="300" height="40" /><text class="d-text" x="150" y="25">{d.git}</text>
      <rect class="d-box" x="0" y="64" width="300" height="40" /><text class="d-text" x="150" y="89">GitLab CI/CD</text>
      <rect class="d-box" x="0" y="128" width="300" height="40" /><text class="d-text" x="150" y="153">Terraform</text>

      <rect class="d-box" x="30" y="192" width="270" height="80" />
      <text class="d-sub" x="165" y="214" font-size="14">{d.clouds}</text>
      <text class="d-text" x="165" y="238">AWS, Google Cloud, Azure,</text>
      <text class="d-text" x="165" y="258">Scaleway, Outscale</text>

      <rect class="d-box" x="30" y="292" width="270" height="80" />
      <text class="d-sub" x="165" y="316" font-size="14">On-premises</text>
      <text class="d-text" x="165" y="345">VMware, OpenShift, Linux</text>

      <rect class="d-box" x="0" y="420" width="300" height="60" />
      <text class="d-text" x="150" y="445">Kubernetes</text>
      <text class="d-text" x="150" y="466">EKS, GKE, AKS, OpenShift</text>

      <rect class="d-dash" x="0" y="508" width="300" height="56" />
      <text class="d-sub" x="150" y="532">{d.observabilityShort[0]}</text>
      <text class="d-sub" x="150" y="551">{d.observabilityShort[1]}</text>
    </g>

    <path class="d-flow flow" pathLength="1" d="M150 40 V64" />
    <path class="d-flow flow flow-2" pathLength="1" d="M150 104 V128" />
    <path class="d-flow flow flow-3" pathLength="1" d="M14 168 V420 M14 232 H30 M14 332 H30" />
    <path class="d-arrow" d="M150 64 l-4 -7 h8 z M150 128 l-4 -7 h8 z" />
    <path class="d-dots" d="M150 480 V508" />
  </svg>

  <figcaption class="mt-3 max-w-[34rem] text-sm text-stone">{d.caption}</figcaption>
</figure>
