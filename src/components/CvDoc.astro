---
// Print-friendly CV, rendered to public/cv.pdf (EN) and public/cv-fr.pdf (FR). Contains NO phone number or street address.
import '../styles/cv.css';
import { content, ui, type Lang } from '../data/i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = ui[lang];
const { profile, skills, experience, earlier, certifications, education, honors, languages } = content(lang);
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{profile.name} – {t.cvTitle}</title>
  </head>
  <body>
    <h1>{profile.name}</h1>
    <p class="sub">{profile.title}, {profile.headline}</p>
    <p class="meta">{profile.email} · {profile.linkedin.replace('https://www.', '')} · {profile.location}</p>

    <h2>{t.cvProfile}</h2>
    {profile.about.map((p) => <p>{p}</p>)}

    <h2>{t.cvExperience}</h2>
    {experience.map((e) => (
      <section>
        <h3>{e.role}, {e.company} <span class="period">· {e.period}</span></h3>
        <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
      </section>
    ))}
    <h3>{t.earlier}</h3>
    <ul>{earlier.map((e) => <li><b>{e.company}</b> ({e.period}), {e.role}: {e.summary}</li>)}</ul>

    <div class="cols">
      <div>
        <h2>{t.cvSkills}</h2>
        <ul>{skills.map((s) => <li><b>{s.group}:</b> {s.items.join(', ')}</li>)}</ul>
      </div>
      <div>
        <h2>{t.cvCerts}</h2>
        <ul>
          {certifications.flatMap((g) => g.items.map((c) => <li>{c.name} ({c.level})</li>))}
        </ul>
      </div>
    </div>

    <h2>{t.cvEducation}</h2>
    <ul>{education.map((e) => <li><b>{e.degree}</b>, {e.school} <span class="period">· {e.period}</span></li>)}</ul>
    <p><b>{t.cvHonors}:</b> {honors.join(' · ')}</p>
    <p><b>{t.languages}:</b> {languages.join(' · ')}</p>
  </body>
</html>
